# ==============================================================================
# Environment Configuration Template — Indesian Digital OPD
# Copy this file to .env before starting the application:
#   cp .env.example .env
# Replace the placeholder dummy values below with your valid credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Required for live generative clinical triage, AI reception, and lab report intelligence.
# If omitted or left as dummy value, the server operates in deterministic local fallback mode.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Application & Server Runtime
# ------------------------------------------------------------------------------
# Port the Node.js/Express server listens on (default: 3000)
PORT=3000

# Base URL where this application is hosted
APP_URL=http://localhost:3000

# Node execution environment ('development' | 'production' | 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# 3. Payment Gateway Configuration (Server-Side Only — Never Exposed to Browser)
# ------------------------------------------------------------------------------
# Provider Type: 'MOCK_SANDBOX' for offline development/testing, or 'RAZORPAY' for production
PAYMENT_GATEWAY_PROVIDER=MOCK_SANDBOX

# Razorpay / NPCI Payment Gateway API Key ID
PAYMENT_GATEWAY_KEY_ID=your_razorpay_key_id_here

# Razorpay / NPCI Payment Gateway Key Secret (Keep confidential)
PAYMENT_GATEWAY_KEY_SECRET=your_razorpay_key_secret_here

# Webhook signature verification secret for HMAC-SHA256 settlement validation
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. Firebase & Cloud Firestore Configuration (Client-side & Server SDKs)
# ------------------------------------------------------------------------------
# Note: In Vite, variables prefixed with VITE_ are accessible to the browser client.
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_DATABASE_ID=(default)

# ------------------------------------------------------------------------------
# 5. Development & Test Account Default Authentication Password
# ------------------------------------------------------------------------------
VITE_DEFAULT_TEST_PASSWORD=your_default_test_password_here

