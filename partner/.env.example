# ==============================================================================
# INDESIAN UNIVERSAL PARTNER PORTAL — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` in the project root:
#   cp .env.example .env
# Fill in the appropriate keys for your local development or production environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
# PORT: Port where the Node.js Express server listens (default: 3000)
PORT=3000

# NODE_ENV: Runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# APP_URL: Base URL where this application or preview instance is reachable
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI API (SERVER-SIDE PROXY)
# ------------------------------------------------------------------------------
# Required for server-authoritative Gemini AI reasoning, document analysis, and triage.
# Get a key from Google AI Studio: https://aistudio.google.com/app/apikey
# NEVER expose this key with VITE_ prefix.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 3. FIREBASE CLIENT CONFIGURATION (VITE FRONTEND)
# ------------------------------------------------------------------------------
# Option A: Full JSON configuration string (recommended for unified config)
# Example: {"apiKey":"AIzaSy...","authDomain":"your-app.firebaseapp.com","projectId":"your-app","storageBucket":"your-app.firebasestorage.app","messagingSenderId":"123456789","appId":"1:123456789:web:abcdef"}
VITE_FIREBASE_CONFIG=

# Option B: Individual Firebase Web App parameters (used if VITE_FIREBASE_CONFIG is empty)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_app_id:web:your_web_id
VITE_FIREBASE_MEASUREMENT_ID=G-YOURMEASUREMENTID

# Optional default initial password used during admin partner approval provisioning
VITE_DEFAULT_PARTNER_INITIAL_PASSWORD=your_secure_temporary_partner_password

# ------------------------------------------------------------------------------
# 4. FIREBASE SERVER & ADMIN CONFIGURATION (SERVER-SIDE SECRETS)
# ------------------------------------------------------------------------------
# Firebase Admin SDK Service Account JSON string or file path for server-side verification
FIREBASE_SERVICE_ACCOUNT=

# FCM Server Key for legacy Cloud Messaging or VAPID public key for Web Push
FCM_SERVER_KEY=your_fcm_server_key_here
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_public_key_here

# ------------------------------------------------------------------------------
# 5. PAYMENT & SETTLEMENT GATEWAY (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Razorpay payment gateway credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# Webhook signing secret for authenticating inbound webhook events from payment gateway
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret_here

# Cashfree payment gateway credentials (alternate/payout rail)
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here

# ------------------------------------------------------------------------------
# 6. n8n AUTOMATION & WORKFLOW ENGINE (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Outbound webhook URL to trigger automated n8n workflows
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/partner-events

# HMAC SHA-256 secret for signing outbound dispatches & verifying inbound n8n payloads
N8N_WEBHOOK_SECRET=your_n8n_hmac_secret_key_here

# ------------------------------------------------------------------------------
# 7. GOOGLE MAPS PLATFORM & GPS TELEMETRY
# ------------------------------------------------------------------------------
# Client-side Google Maps JavaScript API key for ambulance tracking and route maps
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_browser_api_key_here

# Server-side Google Maps Directions / Geocoding API key
GOOGLE_MAPS_API_KEY=your_google_maps_server_api_key_here
