# ==============================================================================
# Production .gitignore - Indesian One Universal Employee Operating System
# Enterprise Credential Protection & Secret Isolation
# ==============================================================================

# 1. Environment Variable Files (Never commit actual credentials)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local
*.env

# Keep the public example template tracked
!.env.example

# 2. Firebase & Cloud Credentials / Generated Configs
firebase-applet-config.json
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
.firebase/
*serviceAccount*.json
*service-account*.json
*credentials*.json
gcp-key*.json
client_secret*.json

# 3. Private Keys, Certificates, and Tokens
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.pkcs12
*.pub

# 4. Dependency Directories
node_modules/
jspm_packages/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.pnp
.pnp.js

# 5. Build Artifacts & Output Bundles
dist/
dist-ssr/
build/
out/
.next/
server.js

# 6. Test Coverage & Emulator Artifacts
coverage/
.nyc_output/
*.lcov
test-results/

# 7. Caches, Build Metadata & Temp Files
.cache/
.vite/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# 8. Runtime & Package Manager Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 9. Operating System & Editor Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
