# ==============================================================================
# INDESIAN ONE UNIVERSAL EMPLOYEE OPERATING SYSTEM
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this template to '.env' or '.env.local' in the root folder:
#    cp .env.example .env.local
# 2. Fill in the values corresponding to your Firebase and AI Studio configurations.
# 3. Never commit '.env' or '.env.local' to git (enforced by .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration
# ------------------------------------------------------------------------------
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web App
VITE_FIREBASE_API_KEY="your-firebase-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"

# Optional: Specific Firestore Named Database (defaults to '(default)' if omitted)
VITE_FIREBASE_DATABASE_ID="(default)"

# Optional: Firebase Analytics Measurement ID
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------------------------
# 2. Google Gemini / AI Studio API Credentials
# ------------------------------------------------------------------------------
# Required for full generative AI responses in the Indesian AI Copilot.
# (If omitted, Copilot operates with deterministic enterprise rule engine).
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_API_KEY="your-gemini-api-key-here"

# ------------------------------------------------------------------------------
# 3. Application Host & Runtime Configuration
# ------------------------------------------------------------------------------
# Application public host URL (used for OAuth callbacks and links)
VITE_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Set to 'true' to disable hot-module-reloading during automated editing
DISABLE_HMR="false"
