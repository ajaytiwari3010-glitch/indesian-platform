# ==============================================================================
# INDESIAN ONE SMART CRM — PRODUCTION .GITIGNORE
# Comprehensive protection against committing secrets, credentials, and build artifacts
# ==============================================================================

# 1. Environment & Secret Configurations (CRITICAL: NEVER COMMIT SECRETS)
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.*.local
.env*.local

# Explicitly whitelist the example template so collaborators know required variables
!.env.example

# 2. Cloud Credentials, Service Accounts & API Secrets
*service-account*.json
*service_account*.json
*credentials*.json
firebase-adminsdk*.json
google-credentials*.json
client_secret*.json
gcp-billing-credentials*.json
*.secret
*.secrets

