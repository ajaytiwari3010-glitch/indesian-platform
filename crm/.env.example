# ==============================================================================
# INDESIAN ONE SMART CRM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env locally: `cp .env.example .env`
# Fill in the appropriate dummy or live keys for your environment.
# DO NOT commit .env or any secret credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI API (SERVER-SIDE ONLY)
# Required for autonomous agents, lead scoring, and conversational intelligence.
# Obtain key at: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"

# ------------------------------------------------------------------------------
# 3. FIREBASE CLIENT CONFIGURATION (VITE CLIENT-SIDE)
# Required for user authentication and Firestore real-time database in browser.
# Obtain from: Firebase Console -> Project Settings -> General -> Web Apps
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY="your_firebase_api_key_here"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------------------------------------------
# 4. FIREBASE ADMIN SDK (SERVER-SIDE ONLY)
# Used by Express server to verify tokens and perform administrative mutations.
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-project-id"
# Optional: Path to service account JSON (if not running in Google Cloud Run)
# GOOGLE_APPLICATION_CREDENTIALS="/absolute/path/to/service-account.json"

# ------------------------------------------------------------------------------
# 5. TRANSACTIONAL EMAIL GATEWAY (SERVER-SIDE ONLY)
# Dispatches notifications, welcome emails, and appointment confirmations.
# ------------------------------------------------------------------------------
EMAIL_PROVIDER_API_KEY="your_sendgrid_or_resend_api_key_here"
EMAIL_PROVIDER_FROM_ADDRESS="notifications@indesian.com"
EMAIL_PROVIDER_FROM_NAME="Indesian One Smart CRM"

# ------------------------------------------------------------------------------
# 6. DIRECT TELECOM & TELEPHONY INTEGRATIONS (SERVER-SIDE ONLY)
# Dual-leg proxy masking: Staff dials pilot number; customer phone is never exposed.
# ------------------------------------------------------------------------------
# Primary Carrier: Jio / JioCX Direct Telecom Enterprise SIP Trunk
JIO_API_KEY="your_jio_api_key_here"
JIO_API_SECRET="your_jio_api_secret_here"
JIO_ACCOUNT_SID="your_jio_account_sid_here"
JIO_PILOT_NUMBER="+912279603000"

# Secondary Fallback Carrier: Airtel IQ Voice Gateway
AIRTEL_IQ_APP_ID="your_airtel_iq_app_id_here"
AIRTEL_IQ_SECRET="your_airtel_iq_secret_here"
AIRTEL_PILOT_NUMBER="+911149804000"

# Optional Tertiary Carrier: Exotel Cloud Telephony
EXOTEL_API_KEY="your_exotel_api_key_here"
EXOTEL_API_TOKEN="your_exotel_api_token_here"
EXOTEL_CALLER_ID="+918049800000"

# ------------------------------------------------------------------------------
# 7. INBOUND WEBHOOK SECRETS & CRYPTOGRAPHIC HMAC SIGNING
# Used to verify inbound webhooks against replay attacks and signature spoofing.
# ------------------------------------------------------------------------------
WHATSAPP_WEBHOOK_SECRET="your_whatsapp_webhook_secret_here"
META_APP_SECRET="your_meta_app_secret_here"
META_WEBHOOK_VERIFY_TOKEN="your_meta_webhook_verify_token_here"
JIO_WEBHOOK_SECRET="your_jio_webhook_secret_here"
AIRTEL_WEBHOOK_SECRET="your_airtel_webhook_secret_here"
SMS_DLT_WEBHOOK_SECRET="your_sms_dlt_webhook_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"
N8N_WEBHOOK_SECRET="your_n8n_webhook_secret_here"
WEBHOOK_MASTER_SECRET="your_master_webhook_signing_secret_here"

# ------------------------------------------------------------------------------
# 8. OMNICHANNEL MESSAGING PROVIDERS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# SMS DLT Gateway (TRAI Compliant)
SMS_PROVIDER_API_KEY="your_sms_provider_api_key_here"
SMS_PROVIDER_SENDER_ID="INDESN"
DLT_API_KEY="your_dlt_provider_api_key_here"

# WhatsApp Business Cloud API (Meta)
WHATSAPP_PROVIDER_API_KEY="your_whatsapp_bearer_token_here"
WHATSAPP_PROVIDER_PHONE_NUMBER_ID="your_whatsapp_phone_number_id_here"
META_WABA_ID="your_meta_waba_account_id_here"
META_PHONE_NUMBER_ID="your_meta_phone_number_id_here"
META_WHATSAPP_TOKEN="your_meta_system_user_token_here"

# ------------------------------------------------------------------------------
# 9. N8N AUTOMATION ENGINE WORKFLOWS
# Automated background CRM triggers and multi-step pipeline actions.
# ------------------------------------------------------------------------------
N8N_WEBHOOK_URL="https://n8n.your-domain.com/webhook/indesian-events"
N8N_API_KEY="your_n8n_api_key_here"
N8N_INSTANCE_URL="https://n8n.your-domain.com"

# ------------------------------------------------------------------------------
# 10. PAYMENT GATEWAY (RAZORPAY / STRIPE)
# Dual-reconciled partner settlement payouts and customer payment collection.
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
PAYMENT_WEBHOOK_SECRET="your_payment_webhook_secret_here"

# ------------------------------------------------------------------------------
# 11. EXTERNAL INTEGRATIONS & COST INTELLIGENCE (PHASE 5B)
# Used to calculate real-time cloud and marketing unit economics.
# ------------------------------------------------------------------------------
GCP_BILLING_CREDENTIALS=""
AD_PLATFORM_API_KEY=""
PAYROLL_API_KEY=""

# ------------------------------------------------------------------------------
# 12. ERP & TALLYPRIME LOCAL BRIDGE (PHASE 10 MULTI-COMPANY)
# XML synchronization bridge for corporate voucher accounting.
# ------------------------------------------------------------------------------
TALLY_BRIDGE_URL="http://127.0.0.1:9000"
TALLY_HOST="http://127.0.0.1"
TALLY_PORT=9000
